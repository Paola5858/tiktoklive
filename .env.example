# Copie para .env e ajuste os valores. Nunca commite o .env real.
# O CLI carrega este arquivo automaticamente sem sobrescrever variáveis já exportadas.

# Execução
ENVIRONMENT=local
LOG_LEVEL=INFO
RUN_MODE=live
PID_FILE=logs/liveengine.pid
SHUTDOWN_TIMEOUT=10.0

# Feature flags. OBS/MQTT são opcionais e desligados por padrão.
FEATURE_TIKTOK=true
FEATURE_ROBLOX=true
FEATURE_OBS=false
FEATURE_MQTT=false
FEATURE_EVENT_RECORDING=true
FEATURE_DEBUG_LOGGING=false

# TikTok Live. Obrigatório apenas em RUN_MODE=live com FEATURE_TIKTOK=true.
TIKTOK_UNIQUE_ID=
TIKTOK_MAX_BUFFER_SIZE=1000
TIKTOK_MAX_RECONNECT_ATTEMPTS=5
TIKTOK_BACKOFF_DELAYS=2,4,8,16,30

# Event Engine
ENGINE_QUEUE_CAPACITY_PER_LEVEL=500
ENGINE_P0_EXPRESS_CAPACITY=100
ENGINE_N_WORKERS=4
ENGINE_MAX_IN_FLIGHT=16
ENGINE_DEDUP_MAXSIZE=10000
ENGINE_DEDUP_TTL_SECONDS=30.0
ENGINE_AGGREGATION_WINDOW_SECONDS=2.0
ENGINE_AGGREGATION_MAX_BUCKET_SIZE=50
ENGINE_OVERFLOW_THRESHOLD_P1=0.90
ENGINE_OVERFLOW_THRESHOLD_P2=0.80
ENGINE_OVERFLOW_THRESHOLD_P3=0.60
ENGINE_OVERFLOW_THRESHOLD_P4=0.50
ENGINE_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=5.0
ENGINE_LATENCY_SAMPLE_SIZE=1000
ENGINE_LOG_EVERY_N_DROPS=50

# Local API / Roblox Bridge
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8787
ROBLOX_BRIDGE_BUFFER_CAPACITY=500
ROBLOX_BRIDGE_MAX_EVENTS_PER_POLL=100
ROBLOX_BRIDGE_DEFAULT_EVENTS_PER_POLL=25
INTERACTION_RULES_PATH=configs/interaction_rules.json
OBS_ACTIONS_PATH=configs/obs_actions.json
AUDIT_LOG_DIR=logs/events

# OBS Studio, opcional. Senha somente aqui ou no ambiente, nunca no código.
OBS_ENABLED=false
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_CONNECT_TIMEOUT_S=10.0
OBS_REQUEST_TIMEOUT_S=5.0
OBS_RECONNECT_DELAYS=2,4,8,16,30
OBS_SCENE_COOLDOWN_S=3.0
OBS_ALLOWED_SCENES=
OBS_ALLOWED_SOURCES=
OBS_QUEUE_MAXSIZE=100

# MQTT / ESP32, opcional. Nunca use dados de usuário em topics.
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=liveengine-local
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=false
MQTT_RECONNECT_ENABLED=true
MQTT_RECONNECT_DELAYS=2,4,8,16,30
MQTT_MAX_QUEUE_SIZE=500
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_PUBLISH_RATE_LIMIT=10.0
MQTT_COMMAND_TTL=30.0
MQTT_ALLOWED_DEVICES=
MQTT_ALLOWED_COMMANDS=SPAWN_AVATAR,PLAY_EFFECT
