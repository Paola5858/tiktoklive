# copie pra `.env` e ajuste os valores. nunca commite o `.env` de verdade.

# ambiente de execução: local | development | staging | production
ENVIRONMENT=local

# nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==========================================
# MQTT / ESP32 IoT Integration (Fase 9)
# ==========================================
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=liveengine-local
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=false
MQTT_RECONNECT_ENABLED=true
MQTT_RECONNECT_DELAYS=2,4,8,16,30
MQTT_MAX_QUEUE_SIZE=500
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_PUBLISH_RATE_LIMIT=10.0
MQTT_COMMAND_TTL=30.0
MQTT_ALLOWED_DEVICES=esp32_led_01,esp32_stage_01
MQTT_ALLOWED_COMMANDS=SPAWN_AVATAR,PLAY_EFFECT,SET_COLOR,TRIGGER_ALERT
